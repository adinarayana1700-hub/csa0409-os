Simulate grep UNIX Command
#include <stdio.h>
#include <string.h>
int main()
{
    char word[20], line[100];
    int n, i;
    printf("Enter word to search: ");
    scanf("%s", word);
    printf("Enter number of lines: ");
    scanf("%d", &n);
    getchar();
    printf("Enter lines:\n");
    for(i = 0; i < n; i++)
    {
        fgets(line, sizeof(line), stdin);
        if(strstr(line, word) != NULL)
            printf("%s", line);
    }
    return 0;
}
