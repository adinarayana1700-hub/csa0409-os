#include <stdio.h>
int main()
{
    int fork[5] = {0, 0, 0, 0, 0};
    int i, left, right;
    for(i = 0; i < 5; i++)
    {
        printf("Philosopher %d is thinking\n", i + 1);
        left = i;
        right = (i + 1) % 5;
        if(fork[left] == 0 && fork[right] == 0)
        {
            fork[left] = 1;
            fork[right] = 1;
            printf("Philosopher %d is eating\n", i + 1);
            fork[left] = 0;
            fork[right] = 0;
            printf("Philosopher %d finished eating\n", i + 1);
        }
        else
        {
            printf("Philosopher %d is waiting\n", i + 1);
        }
    }
    return 0;
}
