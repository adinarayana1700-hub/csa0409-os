4)Translation Lookaside Buffer (TLB)
CODE:
   #include <stdio.h>
    int main() {
    float hitRatio, memoryTime, tlbTime;
    float withTLB, withoutTLB;
   printf("Enter TLB Hit Ratio: ");
    scanf("%f",&hitRatio);
    printf("Enter Memory Access Time: ");
    scanf("%f",&memoryTime);
   printf("Enter TLB Access Time: ");
    scanf("%f",&tlbTime);
   withoutTLB = 2 * memoryTime;
    withTLB = hitRatio * (tlbTime + memoryTime) +
              (1-hitRatio) * (tlbTime + 2*memoryTime);

    printf("Access Time without TLB = %.2f\n", withoutTLB);
    printf("Access Time with TLB = %.2f\n", withTLB);

    return 0;
}
OUTPUT:
Access Time without TLB = 200.00
Access Time with TLB = 130.00


5)Memory Protection (Base and Limit Registers)
CODE:
 #include <stdio.h>
 int main() {
  int base, limit, logical;
   printf("Enter Base Register: ");
    scanf("%d",&base);
   printf("Enter Limit Register: ");
    scanf("%d",&limit);

    printf("Enter Logical Address: ");
    scanf("%d",&logical);

    if(logical >=0 && logical < limit)
        printf("Access Allowed\n");
    else
        printf("Access Denied\n");

    return 0;
}
OUTPUT:
Access Allowed












