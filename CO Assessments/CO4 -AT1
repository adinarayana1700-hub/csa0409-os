    scanf("%d", &choice);
    printf("Seek sequence: %d ", h);
    if (choice == 1) {
        for (i = 0; i < f; i++) {
            seek += abs(h - a[i]);
            h = a[i];
            printf("%d ", h);
        }
    } else {
        for (i = 0; i < f; i++) {
            seek += abs(h - a[i]);
            h = a[i];
            printf("%d ", h);
        }
    }
