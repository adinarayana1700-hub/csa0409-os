        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
                t=a[i],a[i]=a[j],a[j]=t;
    printf("\nC-SCAN: %d ",h);
    t=h;
    for(i=0;i<n;i++)
        if(a[i]>=h)
            s1+=abs(t-a[i]),t=a[i],printf("%d ",t);
    s1+=size-1-t;
    s1+=size-1;
    t=0;
    printf("0 ");
    for(i=0;i<n;i++)
        if(a[i]<h)
            s1+=abs(t-a[i]),t=a[i],printf("%d ",t);
    printf("\nC-SCAN Movement = %d",s1);
    printf("\n\nLOOK: %d ",h);
    t=h;
    for(i=0;i<n;i++)
        if(a[i]>=h)
            s2+=abs(t-a[i]),t=a[i],printf("%d ",t);
    for(i=n-1;i>=0;i--)
