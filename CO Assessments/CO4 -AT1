#include <stdio.h>
int main() {
    int n, f, ch, i, count = 0;
    printf("Disk size: ");
    scanf("%d", &n);
    printf("File size: ");
    scanf("%d", &f);
    printf("1. Contiguous  2. Linked  3. Indexed\n");
    printf("Choice: ");
    scanf("%d", &ch);
    if (f > n) {
        printf("Allocation not possible\n");
        return 0;
    }
    if (ch == 1) {
        printf("Contiguous blocks: ");
        for (i = 0; i < f; i++)
            printf("%d ", i);
    }
    else if (ch == 2) {
        printf("Linked blocks: ");
        for (i = 0; i < f; i++)
            printf("%d ", i);
    }
    else if (ch == 3) {
        printf("Index block: 0\nData blocks: ");
        for (i = 1; i <= f; i++)
            printf("%d ", i);
    }
    else
        printf("Invalid choice");

    return 0;
}

