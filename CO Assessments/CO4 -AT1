#include <stdlib.h>
int main() {
    int n, a[20], h, size, i, j, seek = 0, temp;
    printf("Enter n: ");
    scanf("%d", &n);
    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);
    printf("Enter head: ");
    scanf("%d",&h);
    printf("Enter disk size: ");
    scanf("%d",&size);
    temp=h;
    printf("\nFCFS: %d ",h);
    for(i=0;i<n;i++) {
        seek += abs(temp-a[i]);
        temp=a[i];
        printf("%d ",temp);
    }
    printf("\nSeek Time = %d",seek);
    int used[20]={0}, min, p;
    seek=0; temp=h;
    printf("\n\nSSTF: %d ",h);
    for(i=0;i<n;i++) {
        min=9999;
        for(j=0;j<n;j++)
            if(!used[j] && abs(temp-a[j])<min)
                min=abs(temp-a[j]),p=j;
        used[p]=1;
        seek+=min;
        temp=a[p];
        printf("%d ",temp);
    }
    printf("\nSeek Time = %d",seek);
    seek=0; temp=h;
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                int x=a[i]; a[i]=a[j]; a[j]=x;
            }
    printf("\n\nSCAN: %d ",h);
    for(i=0;i<n;i++)
        if(a[i]>=h) {
            seek+=abs(temp-a[i]);
            temp=a[i];
            printf("%d ",temp);
        }
    seek+=abs(temp-(size-1));
    temp=size-1;
    for(i=n-1;i>=0;i--)
        if(a[i]<h) {
            seek+=abs(temp-a[i]);
            temp=a[i];
            printf("%d ",temp);
        }
    printf("\nSeek Time = %d",seek);
    return 0;
}

