        printf("Index=0 ");
        for (i = 0; i < f; i++) {
            a[i] = i + 1;
            printf("%d ", a[i]);
        }
    }
    printf("\nEnter head position: ");
    scanf("%d", &h);
    printf("1. FCFS\n2. SSTF\n");
